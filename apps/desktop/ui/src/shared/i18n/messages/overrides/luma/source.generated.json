    {
      "id": "luma.ace-combat-7.engine_ini",
      "sourceText": "Apply the following settings manually in Engine.ini.",
      "kind": "engine_ini",
      "context": "guidance.engine_ini"
    },
    {
      "id": "luma.ace-combat-7.game_setting",
      "sourceText": "In the game settings, use: AA \"FXAA High\".",
